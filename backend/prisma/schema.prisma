generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  routes    Route[]
}

model Route {
  id         Int      @id @default(autoincrement())
  userId     Int
  origin     String
  destination String
  distance   Float
  duration   Float
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}